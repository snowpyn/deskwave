[Unit]
Description=DeskWave Linux media bridge
Documentation=https://github.com/snowpyn/deskwave
# The user manager may be started by systemd at boot when lingering is enabled,
# before a graphical session exists. The host can reconnect to the session
# D-Bus and MPRIS players as they become available, so do not gate startup on
# the graphical session target.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/deskwave-host run
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
UMask=0077
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
# Do not add mount-namespace directives such as PrivateTmp, ProtectSystem,
# ProtectHome, or ReadWritePaths here. On Ubuntu, systemd implements them for
# user services with an unprivileged user namespace. AppArmor then labels the
# host `unprivileged_userns`, and confined Snap players (including Spotify)
# reject its otherwise valid MPRIS calls.
# Zeroconf/ifaddr inspects local interfaces through a read-only netlink socket
# before it opens the IPv4 mDNS socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=default.target
